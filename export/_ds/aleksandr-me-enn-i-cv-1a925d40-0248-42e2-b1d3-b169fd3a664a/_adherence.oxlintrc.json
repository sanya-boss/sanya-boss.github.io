{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/navigation/**",
              "components/patterns/**",
              "ui_kits/cv/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Schibsted Grotesk|Geist Mono))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Schibsted Grotesk, Geist Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|name|size|ring|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, alt, name, size, ring."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|solid|accent|live|paper)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'solid' | 'accent' | 'live' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|pill|iconLeft|iconRight|disabled|as|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, pill, iconLeft, iconRight, disabled, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark|ghost|accent|paper)$/]",
        "message": "<Button> variant must be one of 'light' | 'dark' | 'ghost' | 'accent' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m|l)$/]",
        "message": "<Button> size must be one of 's' | 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:button|a)$/]",
        "message": "<Button> as must be one of 'button' | 'a'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|pad|radius|interactive|as|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, pad, radius, interactive, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|raised|quiet|outline|paper)$/]",
        "message": "<Card> variant must be one of 'default' | 'raised' | 'quiet' | 'outline' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CTARow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|action|key|ref|className|style|children)$/]",
        "message": "<CTARow> doesn't accept that prop. Declared props: title, action."
      },
      {
        "selector": "JSXOpeningElement[name.name='DefinitionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|labelWidth|divider|key|ref|className|style|children)$/]",
        "message": "<DefinitionRow> doesn't accept that prop. Declared props: label, labelWidth, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|inset|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: variant, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:dotted|hair|solid|paper)$/]",
        "message": "<Divider> variant must be one of 'dotted' | 'hair' | 'solid' | 'paper'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmailCapture'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|cta|onSubmit|key|ref|className|style|children)$/]",
        "message": "<EmailCapture> doesn't accept that prop. Declared props: placeholder, cta, onSubmit."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:stamp|links|right|width|key|ref|className|style|children)$/]",
        "message": "<FooterBar> doesn't accept that prop. Declared props: stamp, links, right, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|trail|lede|key|ref|className|style|children)$/]",
        "message": "<HeroHeading> doesn't accept that prop. Declared props: lead, trail, lede."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|invalid|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: size, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m)$/]",
        "message": "<Input> size must be one of 's' | 'm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|divider|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: title, meta, divider."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaText'] > JSXAttribute > JSXIdentifier[name!=/^(?:upper|tone|size|key|ref|className|style|children)$/]",
        "message": "<MetaText> doesn't accept that prop. Declared props: upper, tone, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaText'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:primary|secondary|tertiary|accent)$/]",
        "message": "<MetaText> tone must be one of 'primary' | 'secondary' | 'tertiary' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaText'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m)$/]",
        "message": "<MetaText> size must be one of 's' | 'm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|external|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, href, external."
      },
      {
        "selector": "JSXOpeningElement[name.name='PaperSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|date|signature|rotate|width|key|ref|className|style|children)$/]",
        "message": "<PaperSheet> doesn't accept that prop. Declared props: title, date, signature, rotate, width."
      },
      {
        "selector": "JSXOpeningElement[name.name='PriceTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:price|compareAt|sale|key|ref|className|style|children)$/]",
        "message": "<PriceTag> doesn't accept that prop. Declared props: price, compareAt, sale."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|price|compareAt|sale|badge|previewSrc|layout|primaryLabel|secondaryLabel|onPrimary|onSecondary|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: title, description, price, compareAt, sale, badge, previewSrc, layout, primaryLabel, secondaryLabel, onPrimary, onSecondary."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:split|stacked)$/]",
        "message": "<ProductCard> layout must be one of 'split' | 'stacked'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromoCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|titleMuted|body|media|mediaSrc|footer|key|ref|className|style|children)$/]",
        "message": "<PromoCard> doesn't accept that prop. Declared props: title, titleMuted, body, media, mediaSrc, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: as, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m|l)$/]",
        "message": "<SectionLabel> size must be one of 's' | 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShowcaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|badge|description|mark|markSrc|backdrop|dark|key|ref|className|style|children)$/]",
        "message": "<ShowcaseCard> doesn't accept that prop. Declared props: title, badge, description, mark, markSrc, backdrop, dark."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tile'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|glyph|src|alt|background|radius|fill|key|ref|className|style|children)$/]",
        "message": "<Tile> doesn't accept that prop. Declared props: size, glyph, src, alt, background, radius, fill."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
